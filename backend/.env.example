PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/marketElectro?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d

ADMIN_NAME=Admin MarketElectro
ADMIN_EMAIL=admin@marketelectro.polydev.live
ADMIN_PASSWORD=your_secure_admin_password

# Emails transactionnels (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=support@marketelectro.polydev.live
RESEND_FROM_NAME=MarketElectro

# CORS & Liens d'emails (séparés par des virgules si plusieurs domaines)
FRONTEND_URL=https://marketelectro.polydev.live,https://code-alpha-fs-01.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
SECRET_CLIENT=your_google_client_secret

# Cloudinary (Upload photos de profil)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret